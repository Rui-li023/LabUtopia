#usda 1.0
(
    defaultPrim = "SeedFrames"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "SeedFrames"
{
    def Xform "Left"
    {
        double3 xformOp:translate = (-0.15, 0, 0)
        double3 xformOp:scale = (1, 1.5, 0.75)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Xform "Right"
    {
        double3 xformOp:translate = (0.15, 0, 0.03)
        float3 xformOp:rotateXYZ = (-15, 25, 60)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}
