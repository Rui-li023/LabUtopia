<?xml version="1.0"?>
<!-- ABB GoFa CRB 15000-5/0.95 with the project-standard Robotiq 2F-85. -->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="abb_gofa_labutopia_robotiq_2f_85">
  <xacro:include filename="$(find abb_crb15000_support)/urdf/crb15000_5_95_macro.xacro"/>
  <xacro:include filename="$(find robotiq_description)/xacro/2F85.xacro"/>

  <xacro:abb_crb15000_5_95 prefix=""/>
  <xacro:Robotiq85 name=""/>

  <joint name="gofa_tool0_to_gripper_base" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="tool0"/>
    <child link="gripper_base"/>
  </joint>

  <link name="grasp_frame"/>
  <joint name="gripper_base_to_grasp_frame" type="fixed">
    <origin xyz="0 0 0.13" rpy="0 0 0"/>
    <parent link="gripper_base"/>
    <child link="grasp_frame"/>
  </joint>
</robot>
